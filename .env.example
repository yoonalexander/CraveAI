OPENAI_API_KEY=your-openai-key
GOOGLE_API_KEY=your-google-api-key
REDIS_URL=redis://localhost:6379
MODEL_NAME=gpt-5-nano
CHAT_PIPELINE_TIMEOUT_SECONDS=20
CHAT_RANKING_TIMEOUT_SECONDS=12
SQLITE_DB_PATH=./data/craveai.db
USAGE_LIMITS_ENABLED=true
DAILY_TOKEN_LIMIT=10000
DAILY_CHAT_MESSAGE_LIMIT=3
# Local development only. Skips chat quotas and is rejected when APP_ENV=production.
CHAT_DEVELOPER_MODE=false
# Optional deployed-testing bypass. Keep secret server-side; put the same value
# in your browser localStorage key craveai-dev-bypass-secret when testing.
CHAT_DEV_BYPASS_SECRET=
GLOBAL_DAILY_TOKEN_LIMIT=100000
DAILY_PLACES_REQUEST_LIMIT=20
GLOBAL_DAILY_PLACES_REQUEST_LIMIT=1000
IDENTITY_SIGNING_SECRET=replace-with-a-long-random-secret
VITE_API_URL=http://127.0.0.1:8000
