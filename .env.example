# Core providers
OPENAI_API_KEY=replace-in-your-secret-store
GOOGLE_API_KEY=replace-in-your-secret-store
MODEL_NAME=gpt-5-nano

# Supabase Postgres. Use the transaction pooler URL on Render.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres
AUTO_CREATE_SCHEMA=false

# Supabase Auth
SUPABASE_URL=https://gyrxxvxsguwugqueuaav.supabase.co
SUPABASE_ANON_KEY=replace-in-your-secret-store
SUPABASE_SERVICE_ROLE_KEY=replace-in-your-secret-store

# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_ENCRYPTION_KEY=replace-with-a-fernet-key
IDENTITY_SIGNING_SECRET=replace-with-at-least-32-random-characters

# Same-origin production deployment. PUBLIC_API_URL is the externally visible
# Vercel proxy URL used in Supabase email and OAuth callbacks.
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
PUBLIC_API_URL=http://localhost:5173/api
ALLOWED_ORIGINS=http://localhost:5173
TRUSTED_PROXY_IPS=
# Keep browser requests on /api so auth cookies stay first-party. This target is
# used only by Vite's development proxy; do not set VITE_API_URL to Render.
VITE_DEV_API_TARGET=http://127.0.0.1:8000

# Provider timeouts and durable quotas
CHAT_PIPELINE_TIMEOUT_SECONDS=20
CHAT_RANKING_TIMEOUT_SECONDS=12
GUEST_DAILY_CHAT_LIMIT=3
ACCOUNT_DAILY_CHAT_LIMIT=25
GUEST_DAILY_PLACES_LIMIT=20
ACCOUNT_DAILY_PLACES_LIMIT=100
GLOBAL_DAILY_CHAT_LIMIT=100000
GLOBAL_DAILY_PLACES_LIMIT=1000
FEEDBACK_DAILY_LIMIT=20
AUTH_BURST_LIMIT=10
REQUEST_BODY_LIMIT_BYTES=65536

# Application sessions
SESSION_IDLE_DAYS=7
SESSION_ABSOLUTE_DAYS=30
SESSION_ROTATE_HOURS=24
