# Core providers
OPENAI_API_KEY=replace-in-your-secret-store
GOOGLE_API_KEY=replace-in-your-secret-store
# Public browser key. Restrict by website referrer and enable only Maps
# JavaScript, Places, and Geocoding. Never reuse the backend key above.
VITE_GOOGLE_MAPS_API_KEY=replace-with-a-browser-restricted-key
MODEL_NAME=gpt-5-nano

# Supabase Postgres. Use the transaction pooler URL on Render.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres
AUTO_CREATE_SCHEMA=false

# Supabase Auth
SUPABASE_URL=https://gyrxxvxsguwugqueuaav.supabase.co
SUPABASE_ANON_KEY=replace-in-your-secret-store
SUPABASE_SERVICE_ROLE_KEY=replace-in-your-secret-store

# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_ENCRYPTION_KEY=replace-with-a-fernet-key
IDENTITY_SIGNING_SECRET=replace-with-at-least-32-random-characters

# Same-origin production deployment. PUBLIC_API_URL is the externally visible
# Vercel proxy URL used in Supabase email and OAuth callbacks.
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
PUBLIC_API_URL=http://localhost:5173/api
ALLOWED_ORIGINS=http://localhost:5173
TRUSTED_PROXY_IPS=
# Keep browser requests on /api so auth cookies stay first-party. This target is
# used only by Vite's development proxy; do not set VITE_API_URL to Render.
VITE_DEV_API_TARGET=http://127.0.0.1:8000

# Provider timeouts and durable quotas
CHAT_PIPELINE_TIMEOUT_SECONDS=20
CHAT_RANKING_TIMEOUT_SECONDS=12
# Deployment-wide quota multiplier. Keep at 1 for the published plan limits.
DAILY_QUOTA_MULTIPLIER=1
# Keep guest daily ceilings disabled during public testing. Burst and global
# provider-cost safeguards remain enforced.
GUEST_USAGE_LIMITS_ENABLED=false
GUEST_DAILY_CHAT_LIMIT=9
ACCOUNT_DAILY_CHAT_LIMIT=25
GUEST_DAILY_PLACES_LIMIT=60
ACCOUNT_DAILY_PLACES_LIMIT=100
GLOBAL_DAILY_CHAT_LIMIT=100000
GLOBAL_DAILY_PLACES_LIMIT=1000
GLOBAL_DAILY_VOICE_SECONDS=36000
FEEDBACK_DAILY_LIMIT=20
GUEST_DAILY_VOICE_SECONDS=540
ACCOUNT_DAILY_VOICE_SECONDS=900
AUDIO_MAX_BYTES=10485760
AUTH_BURST_LIMIT=10
REQUEST_BODY_LIMIT_BYTES=65536

# Application sessions
SESSION_IDLE_DAYS=7
SESSION_ABSOLUTE_DAYS=30
SESSION_ROTATE_HOURS=24

# Versioned legal documents and launch-blocking operator details. Production
# startup intentionally fails while placeholder values remain.
TERMS_VERSION=2026-08-14
PRIVACY_VERSION=2026-08-14
POLICY_EFFECTIVE_DATE=2026-08-14
OPERATOR_LEGAL_NAME=Alexander Yoon
OPERATOR_ADDRESS="5 London St\nToronto, ON M6G 1M8\nCanada"
GOVERNING_LAW=The laws of the Province of Ontario and the federal laws of Canada applicable therein.
SUPPORT_EMAIL=craveai.support@gmail.com
PRIVACY_EMAIL=craveai.support@gmail.com
